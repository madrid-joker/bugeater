# =============================================================================
# Copy this file to `.env` and fill in real values.  `.env` is gitignored.
#
#   cp .env.example .env
#
# Anything secret lives here and NOWHERE else. No credential should ever be
# committed, hardcoded in a spec, or pasted into a page object.
# =============================================================================

# ---- Target ------------------------------------------------------------------
# The application under test. Overridable so the same suite can be pointed at a
# future staging environment without touching a line of code.
BASE_URL=https://www.saucedemo.com

# ---- Test account ------------------------------------------------------------
# A DEDICATED account that exists only to be automated. Never a personal login.
# Only required by tests that need an authenticated session; read-only tests
# run fine without these set.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# ---- Execution ---------------------------------------------------------------
# Parallel workers. Kept low by default because the target is a live production
# site on Firebase — see the comment in playwright.config.ts.
PW_WORKERS=

# Set to 1 to run browsers headed locally (equivalent to --headed).
PW_HEADED=
